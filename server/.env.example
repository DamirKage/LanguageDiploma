NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/linguapath
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
# Development only: returns the password-reset link in the API response when SMTP is not configured.
EXPOSE_DEV_LINKS=true
# smtp://user:password@smtp.example.com:587
SMTP_URL=
MAIL_FROM=LinguaPath <no-reply@linguapath.local>
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
DICTIONARY_ENABLED=true
LOG_LEVEL=info
# Seed script
SEED_ADMIN_EMAIL=admin@linguapath.local
SEED_ADMIN_PASSWORD=LinguaAdmin2026
SEED_DEMO_PASSWORD=LinguaDemo2026
